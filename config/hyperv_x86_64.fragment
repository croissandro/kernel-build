# CroissAndro x86_64 Hyper-V guest configuration.
# Boot-critical synthetic devices stay built in until PI-1 owns module loading.

# Hyper-V guest core and synthetic device bus.
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y

# Root storage and synthetic networking.
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y

# Device assignment and Hyper-V interrupt handling.
CONFIG_PCI_HYPERV=y
CONFIG_HYPERV_IOMMU=y

# Basic console-adjacent input devices.
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y

# Host/guest services used by diagnostics and later Android integration.
CONFIG_CONNECTOR=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
